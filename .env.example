# StyleShift Environment Variables
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model for rewriting & style evaluation (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Gemini Embedding Model for meaning preservation cosine similarity (default: gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
